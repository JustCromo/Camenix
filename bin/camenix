#!/usr/bin/env python3
"""Avvia Camenix dal repository, ovunque sia clonato (anche tramite collegamento in ~/.local/bin)."""
import os
import sys

root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, root)
from camenix.cli import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
